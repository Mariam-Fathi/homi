# Copy to .env for running the API outside Docker (docker-compose sets these itself).

DATABASE_URL=postgresql+psycopg://homi:homi@localhost:5433/homi

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

# Lets anyone create a guest account. Keep on for the public demo.
DEMO_LOGIN_ENABLED=true

ENVIRONMENT=development
