# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app.

# Appwrite
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_PROPERTIES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_AGENTS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_REVIEWS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_GALLERIES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_USER_FAVORITES_COLLECTION_ID=
# Optional: features are disabled when these are empty
EXPO_PUBLIC_APPWRITE_USER_ACTIVITY_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_NOTIFICATIONS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_PAYMENTS_COLLECTION_ID=

# Stripe
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only (used by app/api routes). Never prefix with EXPO_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...
