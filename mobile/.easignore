# EAS uses this file instead of .gitignore, so secrets that are gitignored but
# required for builds (e.g. google-services.json) are still uploaded.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase admin credentials must never ship with the app
*firebase-adminsdk*.json

# typescript
*.tsbuildinfo

# test coverage reports
/coverage

/android
/ios
